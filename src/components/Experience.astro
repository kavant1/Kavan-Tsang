---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="section">
      <div class="shell">
        <div class="section-head reveal">
          <span class="overline">Experience</span>
          <h2 class="section-title">Where I've worked</h2>
        </div>

        <div class="relative" id="exp-track">

          <!-- Continuous background rail line (desktop only) -->
          <div id="exp-rail"
               class="hidden md:block absolute top-0 bottom-0 w-px pointer-events-none"
               style="background: var(--border);"
          />

          <!-- Accent fill line — height grows as moving dot descends -->
          <div id="exp-fill"
               class="hidden md:block absolute w-px pointer-events-none"
               style="background: linear-gradient(to bottom, var(--accent), color-mix(in srgb, var(--accent) 30%, transparent)); top: 0; height: 0; will-change: height;"
          />

          <!-- Moving glowing dot -->
          <div id="exp-dot-moving"
               class="hidden md:block absolute w-4 h-4 rounded-full pointer-events-none -translate-x-1/2 -translate-y-1/2"
               style="background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 16%, transparent), 0 0 20px color-mix(in srgb, var(--accent) 45%, transparent); top: 0; left: 0; will-change: top;"
          />

          {siteConfig.experience.map((exp, index) => (
            <div
              class="exp-entry reveal relative grid grid-cols-1 md:grid-cols-[200px_1fr] gap-x-10 gap-y-3 pb-12 last:pb-0 pl-8 md:pl-0"
              style={`--d:${index * 0.05}s`}
            >
              {/* Mobile timeline rail + dot */}
              <span class="md:hidden absolute left-[5px] top-2 bottom-0 w-px"
                    style="background: linear-gradient(to bottom, var(--accent), var(--border))" />
              <span class="md:hidden absolute left-0 top-1.5 w-2.5 h-2.5 rounded-full"
                    style="background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent), 0 0 12px color-mix(in srgb, var(--accent) 35%, transparent)" />

              <div class="md:text-right">
                <span class="t-faint text-sm font-medium">{exp.dateRange}</span>
              </div>

              <div class="md:pl-10 relative">
                <!-- Static reference dot — JS reads position, sets glow when passed -->
                <span
                  class="exp-static-dot hidden md:block absolute -left-[5px] top-1.5 w-3 h-3 rounded-full"
                  style="background: var(--border-strong); transition: background 0.3s, box-shadow 0.3s;"
                />
                <h3 class="text-lg font-semibold">{exp.title}</h3>
                <p class="t-accent font-medium">{exp.company}</p>
                <ul class="mt-3 space-y-2">
                  {exp.bullets.map((bullet) => (
                    <li class="flex gap-3 t-muted text-[0.97rem] leading-relaxed">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--text-faint)]" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  const track      = document.getElementById("exp-track")     as HTMLElement | null;
  const rail       = document.getElementById("exp-rail")      as HTMLElement | null;
  const fill       = document.getElementById("exp-fill")      as HTMLElement | null;
  const movingDot  = document.getElementById("exp-dot-moving") as HTMLElement | null;
  const staticDots = Array.from(
    document.querySelectorAll(".exp-static-dot")
  ) as HTMLElement[];

  if (track && rail && fill && movingDot && staticDots.length > 0) {

    // ── Align rail / fill / moving-dot to the static dots' X ─────
    const alignX = () => {
      const first     = staticDots[0].getBoundingClientRect();
      const container = track.getBoundingClientRect();
      const cx        = first.left - container.left + first.width / 2;
      rail.style.left      = `${cx - 0.5}px`;
      fill.style.left      = `${cx - 0.5}px`;
      movingDot.style.left = `${cx}px`;
    };

    // ── Recalculate moving dot Y and fill height on every scroll ──
    const update = () => {
      const containerRect = track.getBoundingClientRect();
      const firstRect     = staticDots[0].getBoundingClientRect();
      const lastRect      = staticDots[staticDots.length - 1].getBoundingClientRect();
      const viewCenter    = window.innerHeight / 2;

      // Base: 0 when viewport centre is at first dot, 1 when at last dot
      const range        = lastRect.top - firstRect.top;
      const baseProgress = range > 0
        ? Math.max(0, Math.min(1, (viewCenter - firstRect.top) / range))
        : 0;

      // Near-bottom correction: when the page end is within 250px of the
      // viewport bottom the last dot may never reach centre — blend to 1.
      const scrollBottom   = window.scrollY + window.innerHeight;
      const pageHeight     = document.documentElement.scrollHeight;
      const nearBottomFactor = Math.max(0, Math.min(1,
        (scrollBottom - (pageHeight - 250)) / 250
      ));

      const progress = Math.max(baseProgress, nearBottomFactor);

      // Y positions relative to the track container
      const firstY = firstRect.top - containerRect.top + firstRect.height / 2;
      const lastY  = lastRect.top  - containerRect.top + lastRect.height  / 2;
      const dotY   = firstY + progress * (lastY - firstY);

      movingDot.style.top = `${dotY}px`;
      fill.style.top      = `${firstY}px`;
      fill.style.height   = `${Math.max(0, dotY - firstY)}px`;

      // Light up static dots the moving dot has reached or passed
      staticDots.forEach((dot) => {
        const r      = dot.getBoundingClientRect();
        const dotYLocal = r.top - containerRect.top + r.height / 2;
        const passed = dotYLocal <= dotY + 2;
        dot.style.background = passed
          ? "var(--accent)"
          : "var(--border-strong)";
        dot.style.boxShadow = passed
          ? "0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent), 0 0 14px color-mix(in srgb, var(--accent) 38%, transparent)"
          : "none";
      });
    };

    alignX();
    update();

    let rafId = 0;
    const onScroll = () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => { alignX(); update(); });
  }
</script>
