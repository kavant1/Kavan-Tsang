---
import { siteConfig } from "../config";

const affiliations = [
  { name: "Wood Neuro Research Group", href: "https://www.cmu.edu/bme/woodneurolab/" },
];

const skillGroups = [
  { label: "Programming",        skills: ["Python", "NumPy / Pandas / SciPy / Matplotlib", "MATLAB", "HTML"] },
  { label: "Simulation & Tools", skills: ["COMSOL Multiphysics", "Aspen Plus", "AutoCAD", "Microsoft Excel"] },
  { label: "Research Methods",   skills: ["EEG data processing", "Signal processing", "Fluid systems modeling"] },
  { label: "Languages",          skills: ["English & Cantonese"] },
];
---

<section id="about" class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="overline">About</span>
      <h2 class="section-title">Chemical engineer by training, Biomedical researcher by curiosity</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7 reveal" data-reveal="left" style="--d:.05s">
        <p class="lede">{siteConfig.aboutMe}</p>

        <div class="mt-10">
          <p class="label">Affiliations</p>
          <div class="flex flex-wrap gap-3">
            {
              affiliations.map((a) => (
                <a
                  href={a.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="chip chip-link"
                >
                  {a.name}
                  <span aria-hidden="true" class="ml-1.5 t-faint">↗</span>
                </a>
              ))
            }
          </div>
        </div>

      </div>

      <div class="lg:col-span-5 reveal" data-reveal="right" style="--d:.12s">
        <p class="label">Skills &amp; methods</p>
        {skillGroups.map((group) => (
          <div class="skill-group">
            <p class="skill-group-label">{group.label}</p>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => <span class="chip">{skill}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
