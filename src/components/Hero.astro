<script>
  // Hide static molecule-bg once JS is present (Three.js scene takes over)
  document.querySelector(".js-hidden")?.classList.add("hidden");

  // ── Typewriter on hero tagline ─────────────────────────────────
  const tagline = document.getElementById("hero-tagline");
  if (tagline) {
    const text   = tagline.getAttribute("aria-label") || "";
    const cursor = document.createElement("span");
    cursor.className = "tw-cursor";
    tagline.appendChild(cursor);
    let i = 0;
    const type = () => {
      if (i < text.length) {
        tagline.insertBefore(document.createTextNode(text[i++]), cursor);
        setTimeout(type, i < 10 ? 60 : 28);
      } else {
        setTimeout(() => cursor.remove(), 1200);
      }
    };
    setTimeout(type, 500);
  }
</script>
