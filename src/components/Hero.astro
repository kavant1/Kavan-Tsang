---
import { siteConfig } from "../config";
import { GenerativeArtScene } from "./ui/anomalous-matter-hero";
---

<section id="hero" class="relative overflow-hidden">

  <!-- 3-D generative art background (Three.js, React island) -->
  <GenerativeArtScene client:load />

  <!-- kept for SSR/no-JS fallback visibility — hidden once JS hydrates -->
  <div class="molecule-bg absolute inset-0 overflow-hidden pointer-events-none js-hidden" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice"
      fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">

      <!-- ── CLUSTER A (left): 3 fused rings ── -->
      <polygon points="110,161 130.8,173 130.8,197 110,209 89.2,197 89.2,173" stroke-width="1.5"/>
      <circle cx="110" cy="185" r="12" stroke-width="1.2"/>
      <polygon points="151.6,161 172.4,173 172.4,197 151.6,209 130.8,197 130.8,173" stroke-width="1.5"/>
      <polygon points="130.8,197 151.6,209 151.6,233 130.8,245 110,233 110,209" stroke-width="1.5"/>
      <circle cx="130.8" cy="221" r="12" stroke-width="1.2"/>
      <!-- chains -->
      <line x1="110" y1="161" x2="88" y2="139" stroke-width="1.5"/>
      <line x1="88" y1="139" x2="64" y2="125" stroke-width="1.5"/>
      <circle cx="64" cy="125" r="3" fill="currentColor" stroke="none"/>
      <line x1="89.2" y1="173" x2="62" y2="159" stroke-width="1.5"/>
      <circle cx="62" cy="159" r="3" fill="currentColor" stroke="none"/>
      <line x1="172.4" y1="173" x2="198" y2="157" stroke-width="1.5"/>
      <line x1="198" y1="157" x2="226" y2="143" stroke-width="1.5"/>
      <circle cx="226" cy="143" r="3" fill="currentColor" stroke="none"/>
      <line x1="172.4" y1="197" x2="198" y2="211" stroke-width="1.5"/>
      <circle cx="198" cy="211" r="3" fill="currentColor" stroke="none"/>
      <line x1="130.8" y1="245" x2="130.8" y2="272" stroke-width="1.5"/>
      <line x1="130.8" y1="272" x2="110" y2="290" stroke-width="1.5"/>
      <circle cx="110" cy="290" r="3" fill="currentColor" stroke="none"/>
      <line x1="110" y1="233" x2="84" y2="247" stroke-width="1.5"/>
      <circle cx="84" cy="247" r="3" fill="currentColor" stroke="none"/>

      <!-- ── CLUSTER B (center-top): 5 fused rings (pyrene-like) ── -->
      <polygon points="400,116 420.8,128 420.8,152 400,164 379.2,152 379.2,128" stroke-width="1.5"/>
      <circle cx="400" cy="140" r="12" stroke-width="1.2"/>
      <polygon points="441.6,116 462.4,128 462.4,152 441.6,164 420.8,152 420.8,128" stroke-width="1.5"/>
      <polygon points="483.2,116 504,128 504,152 483.2,164 462.4,152 462.4,128" stroke-width="1.5"/>
      <circle cx="483.2" cy="140" r="12" stroke-width="1.2"/>
      <polygon points="420.8,152 441.6,164 441.6,188 420.8,200 400,188 400,164" stroke-width="1.5"/>
      <polygon points="462.4,152 483.2,164 483.2,188 462.4,200 441.6,188 441.6,164" stroke-width="1.5"/>
      <circle cx="462.4" cy="176" r="12" stroke-width="1.2"/>
      <!-- chains -->
      <line x1="400" y1="116" x2="378" y2="92" stroke-width="1.5"/>
      <line x1="378" y1="92" x2="356" y2="76" stroke-width="1.5"/>
      <circle cx="356" cy="76" r="3" fill="currentColor" stroke="none"/>
      <line x1="483.2" y1="116" x2="506" y2="92" stroke-width="1.5"/>
      <line x1="506" y1="92" x2="532" y2="80" stroke-width="1.5"/>
      <circle cx="532" cy="80" r="3" fill="currentColor" stroke="none"/>
      <line x1="504" y1="140" x2="534" y2="140" stroke-width="1.5"/>
      <line x1="534" y1="140" x2="560" y2="124" stroke-width="1.5"/>
      <circle cx="560" cy="124" r="3" fill="currentColor" stroke="none"/>
      <line x1="420.8" y1="200" x2="400" y2="220" stroke-width="1.5"/>
      <line x1="400" y1="220" x2="378" y2="236" stroke-width="1.5"/>
      <circle cx="378" cy="236" r="3" fill="currentColor" stroke="none"/>
      <line x1="483.2" y1="188" x2="504" y2="208" stroke-width="1.5"/>
      <circle cx="504" cy="208" r="3" fill="currentColor" stroke="none"/>
      <line x1="379.2" y1="128" x2="354" y2="114" stroke-width="1.5"/>
      <circle cx="354" cy="114" r="3" fill="currentColor" stroke="none"/>

      <!-- ── CLUSTER C (right): 4 fused rings ── -->
      <polygon points="780,196 800.8,208 800.8,232 780,244 759.2,232 759.2,208" stroke-width="1.5"/>
      <circle cx="780" cy="220" r="12" stroke-width="1.2"/>
      <polygon points="821.6,196 842.4,208 842.4,232 821.6,244 800.8,232 800.8,208" stroke-width="1.5"/>
      <polygon points="800.8,232 821.6,244 821.6,268 800.8,280 780,268 780,244" stroke-width="1.5"/>
      <circle cx="800.8" cy="256" r="12" stroke-width="1.2"/>
      <polygon points="863.2,196 884,208 884,232 863.2,244 842.4,232 842.4,208" stroke-width="1.5"/>
      <!-- chains -->
      <line x1="780" y1="196" x2="758" y2="172" stroke-width="1.5"/>
      <line x1="758" y1="172" x2="734" y2="158" stroke-width="1.5"/>
      <circle cx="734" cy="158" r="3" fill="currentColor" stroke="none"/>
      <line x1="759.2" y1="208" x2="730" y2="194" stroke-width="1.5"/>
      <circle cx="730" cy="194" r="3" fill="currentColor" stroke="none"/>
      <line x1="884" y1="220" x2="914" y2="220" stroke-width="1.5"/>
      <line x1="914" y1="220" x2="940" y2="204" stroke-width="1.5"/>
      <line x1="940" y1="204" x2="968" y2="218" stroke-width="1.5"/>
      <circle cx="968" cy="218" r="3" fill="currentColor" stroke="none"/>
      <line x1="884" y1="208" x2="910" y2="192" stroke-width="1.5"/>
      <circle cx="910" cy="192" r="3" fill="currentColor" stroke="none"/>
      <line x1="800.8" y1="280" x2="800.8" y2="308" stroke-width="1.5"/>
      <line x1="800.8" y1="308" x2="778" y2="322" stroke-width="1.5"/>
      <circle cx="778" cy="322" r="3" fill="currentColor" stroke="none"/>
      <line x1="821.6" y1="268" x2="842.4" y2="284" stroke-width="1.5"/>
      <circle cx="842.4" cy="284" r="3" fill="currentColor" stroke="none"/>

      <!-- ── CLUSTER D (bottom-center): 3 fused rings ── -->
      <polygon points="570,398 589,409 589,431 570,442 551,431 551,409" stroke-width="1.5"/>
      <circle cx="570" cy="420" r="11" stroke-width="1.2"/>
      <polygon points="608,398 627,409 627,431 608,442 589,431 589,409" stroke-width="1.5"/>
      <polygon points="589,431 608,442 608,464 589,475 570,464 570,442" stroke-width="1.5"/>
      <!-- chains -->
      <line x1="570" y1="398" x2="548" y2="374" stroke-width="1.5"/>
      <line x1="548" y1="374" x2="524" y2="360" stroke-width="1.5"/>
      <circle cx="524" cy="360" r="3" fill="currentColor" stroke="none"/>
      <line x1="627" y1="420" x2="658" y2="420" stroke-width="1.5"/>
      <line x1="658" y1="420" x2="684" y2="404" stroke-width="1.5"/>
      <circle cx="684" cy="404" r="3" fill="currentColor" stroke="none"/>
      <line x1="589" y1="475" x2="570" y2="496" stroke-width="1.5"/>
      <circle cx="570" cy="496" r="3" fill="currentColor" stroke="none"/>
      <line x1="551" y1="420" x2="520" y2="420" stroke-width="1.5"/>
      <line x1="520" y1="420" x2="494" y2="436" stroke-width="1.5"/>
      <circle cx="494" cy="436" r="3" fill="currentColor" stroke="none"/>

      <!-- ── ISOLATED RING: top-right (950, 130) ── -->
      <polygon points="950,108 969,119 969,141 950,152 931,141 931,119" stroke-width="1.5"/>
      <circle cx="950" cy="130" r="11" stroke-width="1.2"/>
      <line x1="969" y1="119" x2="994" y2="103" stroke-width="1.5"/>
      <circle cx="994" cy="103" r="3" fill="currentColor" stroke="none"/>
      <line x1="931" y1="119" x2="906" y2="103" stroke-width="1.5"/>
      <line x1="906" y1="103" x2="880" y2="117" stroke-width="1.5"/>
      <circle cx="880" cy="117" r="3" fill="currentColor" stroke="none"/>
      <line x1="950" y1="152" x2="950" y2="178" stroke-width="1.5"/>
      <circle cx="950" cy="178" r="3" fill="currentColor" stroke="none"/>

      <!-- ── ISOLATED RING: bottom-right (1050, 450) ── -->
      <polygon points="1050,430 1067.3,440 1067.3,460 1050,470 1032.7,460 1032.7,440" stroke-width="1.5"/>
      <line x1="1067.3" y1="450" x2="1096" y2="450" stroke-width="1.5"/>
      <circle cx="1096" cy="450" r="3" fill="currentColor" stroke="none"/>
      <line x1="1032.7" y1="440" x2="1010" y2="424" stroke-width="1.5"/>
      <circle cx="1010" cy="424" r="3" fill="currentColor" stroke="none"/>
      <line x1="1050" y1="470" x2="1050" y2="496" stroke-width="1.5"/>
      <circle cx="1050" cy="496" r="3" fill="currentColor" stroke="none"/>

      <!-- ── ISOLATED RING: top-left (240, 80) ── -->
      <polygon points="240,60 257.3,70 257.3,90 240,100 222.7,90 222.7,70" stroke-width="1.5"/>
      <circle cx="240" cy="80" r="10" stroke-width="1.2"/>
      <line x1="240" y1="60" x2="240" y2="36" stroke-width="1.5"/>
      <line x1="240" y1="36" x2="260" y2="18" stroke-width="1.5"/>
      <circle cx="260" cy="18" r="3" fill="currentColor" stroke="none"/>
      <line x1="257.3" y1="70" x2="284" y2="56" stroke-width="1.5"/>
      <circle cx="284" cy="56" r="3" fill="currentColor" stroke="none"/>
      <line x1="222.7" y1="70" x2="196" y2="56" stroke-width="1.5"/>
      <circle cx="196" cy="56" r="3" fill="currentColor" stroke="none"/>
      <line x1="222.7" y1="90" x2="196" y2="104" stroke-width="1.5"/>
      <circle cx="196" cy="104" r="3" fill="currentColor" stroke="none"/>

      <!-- ── ISOLATED RING: bottom-left (1150, 320) ── -->
      <polygon points="1150,298 1169,309 1169,331 1150,342 1131,331 1131,309" stroke-width="1.5"/>
      <line x1="1131" y1="320" x2="1102" y2="320" stroke-width="1.5"/>
      <circle cx="1102" cy="320" r="3" fill="currentColor" stroke="none"/>
      <line x1="1150" y1="298" x2="1150" y2="272" stroke-width="1.5"/>
      <circle cx="1150" cy="272" r="3" fill="currentColor" stroke="none"/>
      <line x1="1169" y1="309" x2="1194" y2="295" stroke-width="1.5"/>
      <circle cx="1194" cy="295" r="3" fill="currentColor" stroke="none"/>

      <!-- ── SCATTERED bond chains ── -->
      <circle cx="50" cy="380" r="3" fill="currentColor" stroke="none"/>
      <line x1="50" y1="380" x2="76" y2="364" stroke-width="1.5"/>
      <line x1="76" y1="364" x2="104" y2="378" stroke-width="1.5"/>
      <line x1="104" y1="378" x2="130" y2="362" stroke-width="1.5"/>
      <circle cx="130" cy="362" r="3" fill="currentColor" stroke="none"/>

      <circle cx="700" cy="60" r="3" fill="currentColor" stroke="none"/>
      <line x1="700" y1="60" x2="730" y2="44" stroke-width="1.5"/>
      <line x1="730" y1="44" x2="758" y2="58" stroke-width="1.5"/>
      <circle cx="758" cy="58" r="3" fill="currentColor" stroke="none"/>
      <line x1="758" y1="58" x2="784" y2="44" stroke-width="1.5"/>
      <circle cx="784" cy="44" r="3" fill="currentColor" stroke="none"/>

      <circle cx="310" cy="340" r="3" fill="currentColor" stroke="none"/>
      <line x1="310" y1="340" x2="338" y2="324" stroke-width="1.5"/>
      <line x1="338" y1="324" x2="366" y2="338" stroke-width="1.5"/>
      <circle cx="366" cy="338" r="3" fill="currentColor" stroke="none"/>

      <circle cx="640" cy="290" r="3" fill="currentColor" stroke="none"/>
      <line x1="640" y1="290" x2="668" y2="274" stroke-width="1.5"/>
      <line x1="668" y1="274" x2="696" y2="288" stroke-width="1.5"/>
      <circle cx="696" cy="288" r="3" fill="currentColor" stroke="none"/>

      <circle cx="150" cy="530" r="3" fill="currentColor" stroke="none"/>
      <line x1="150" y1="530" x2="178" y2="514" stroke-width="1.5"/>
      <line x1="178" y1="514" x2="206" y2="528" stroke-width="1.5"/>
      <circle cx="206" cy="528" r="3" fill="currentColor" stroke="none"/>

      <!-- junction accent dots -->
      <circle cx="420.8" cy="200" r="4" fill="currentColor" stroke="none"/>
      <circle cx="462.4" cy="152" r="4" fill="currentColor" stroke="none"/>
      <circle cx="800.8" cy="232" r="4" fill="currentColor" stroke="none"/>
      <circle cx="589" cy="431" r="4" fill="currentColor" stroke="none"/>
    </svg>
  </div>

  <div class="shell pt-32 pb-20 md:pt-40 md:pb-28 relative" style="z-index: 1;">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <div class="lg:col-span-7">
        <span id="hero-tagline" class="overline" aria-label="Carnegie Mellon University · Chemical Engineering & Biomedical Engineering"></span>

        <h1
          class="gradient-text rise mt-6 tracking-[0.04em] leading-[1.1] pb-1 text-[clamp(3rem,9vw,6.5rem)]"
          style="font-family: var(--font-display); font-weight: 300;"
          style="--d:.06s"
        >
          Kavan Tsang
        </h1>

        <p
          class="rise mt-7 max-w-xl text-[clamp(1.1rem,2.4vw,1.4rem)] leading-relaxed t-muted"
          style="--d:.16s"
        >
          Studying <span class="t-accent">chemical</span> and <span class="t-accent">biomedical engineering</span> at Carnegie Mellon — building at the intersection of fluid systems, medical devices, and computational modeling.
        </p>

        <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--d:.24s">
          <a href="#projects" class="btn btn-primary">
            View projects
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <div class="rise mt-10 flex items-center gap-5" style="--d:.32s">
          <a href="#contact" aria-label="Contact" class="social-link">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
          </a>
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="social-link"
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.researchgate && (
              <a
                href={siteConfig.social.researchgate}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="ResearchGate"
                class="social-link"
              >
                <svg
                  role="img"
                  viewBox="0 0 24 24"
                  class="h-[22px] w-[22px] fill-current"
                >
                  <path d="M19.586 0c-0.818 0 -1.508 0.19 -2.073 0.565 -0.563 0.377 -0.97 0.936 -1.213 1.68a3.193 3.193 0 0 0 -0.112 0.437 8.365 8.365 0 0 0 -0.078 0.53 9 9 0 0 0 -0.05 0.727c-0.01 0.282 -0.013 0.621 -0.013 1.016a31.121 31.123 0 0 0 0.014 1.017 9 9 0 0 0 0.05 0.727 7.946 7.946 0 0 0 0.077 0.53h-0.005a3.334 3.334 0 0 0 0.113 0.438c0.245 0.743 0.65 1.303 1.214 1.68 0.565 0.376 1.256 0.564 2.075 0.564 0.8 0 1.536 -0.213 2.105 -0.603 0.57 -0.39 0.94 -0.916 1.175 -1.65 0.076 -0.235 0.135 -0.558 0.177 -0.93a10.9 10.9 0 0 0 0.043 -1.207v-0.82c0 -0.095 -0.047 -0.142 -0.14 -0.142h-3.064c-0.094 0 -0.14 0.047 -0.14 0.141v0.956c0 0.094 0.046 0.14 0.14 0.14h1.666c0.056 0 0.084 0.03 0.084 0.086 0 0.36 0 0.62 -0.036 0.865 -0.038 0.244 -0.1 0.447 -0.147 0.606 -0.108 0.385 -0.348 0.664 -0.638 0.876 -0.29 0.212 -0.738 0.35 -1.227 0.35 -0.545 0 -0.901 -0.15 -1.21 -0.353 -0.306 -0.203 -0.517 -0.454 -0.67 -0.915a3.136 3.136 0 0 1 -0.147 -0.762 17.366 17.367 0 0 1 -0.034 -0.656c-0.01 -0.26 -0.014 -0.572 -0.014 -0.939a26.401 26.403 0 0 1 0.014 -0.938 15.821 15.822 0 0 1 0.035 -0.656 3.19 3.19 0 0 1 0.148 -0.76 1.89 1.89 0 0 1 0.742 -1.01c0.344 -0.244 0.593 -0.352 1.137 -0.352 0.508 0 0.815 0.096 1.144 0.303 0.33 0.207 0.528 0.492 0.764 0.925 0.047 0.094 0.111 0.118 0.198 0.07l1.044 -0.43c0.075 -0.048 0.09 -0.115 0.042 -0.199a3.549 3.549 0 0 0 -0.466 -0.742 3 3 0 0 0 -0.679 -0.607 3.313 3.313 0 0 0 -0.903 -0.41A4.068 4.068 0 0 0 19.586 0zM8.217 5.836c-1.69 0 -3.036 0.086 -4.297 0.086 -1.146 0 -2.291 0 -3.007 -0.029v0.831l1.088 0.2c0.744 0.144 1.174 0.488 1.174 2.264v11.288c0 1.777 -0.43 2.12 -1.174 2.263l-1.088 0.2v0.832c0.773 -0.029 2.12 -0.086 3.465 -0.086 1.29 0 2.951 0.057 3.667 0.086v-0.831l-1.49 -0.2c-0.773 -0.115 -1.174 -0.487 -1.174 -2.264v-4.784c0.688 0.057 1.29 0.057 2.206 0.057 1.748 3.123 3.41 5.472 4.355 6.56 0.86 1.032 2.177 1.691 3.839 1.691 0.487 0 1.003 -0.086 1.318 -0.23v-0.744c-1.031 0 -2.063 -0.716 -2.808 -1.518 -1.26 -1.376 -2.95 -3.582 -4.355 -6.074 2.32 -0.545 4.04 -2.722 4.04 -4.9 0 -3.208 -2.492 -4.698 -5.758 -4.698zm-0.515 1.29c2.406 0 3.839 1.26 3.839 3.552 0 2.263 -1.547 3.782 -4.097 3.782 -0.974 0 -1.404 -0.03 -2.063 -0.086v-7.19c0.66 -0.059 1.547 -0.059 2.32 -0.059z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.scholar && (
              <a
                href={siteConfig.social.scholar}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Google Scholar"
                class="social-link"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-[22px] w-[22px]"
                >
                  <path d="M12 3L1 9l11 6l9-4.91V17h2V9L12 3zm0 13L5.74 12.73V16.5c0 2.49 2.97 4.5 6.26 4.5s6.26-2.01 6.26-4.5v-3.77L12 16z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="social-link"
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
        </div>
      </div>

      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="rise relative" style="--d:.2s">
