---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const [featured, ...rest] = siteConfig.projects ?? [];
---

{
  hasProjects && (
    <section id="projects" class="section">
      <div class="shell">
        <div class="section-head reveal">
          <span class="overline">Selected work</span>
          <h2 class="section-title">Research &amp; Projects</h2>
        </div>

        {/* Featured project — full width, accented */}
        {featured && (() => {
          const Tag = featured.link ? "a" : "div";
          const linkProps = featured.link
            ? { href: featured.link, target: "_blank", rel: "noopener noreferrer" }
            : {};
          return (
            <Tag
              {...linkProps}
              class={`card featured-card group relative flex flex-col p-8 md:p-10 mb-5 reveal ${featured.link ? "card-hover" : ""}`}
              data-reveal="up"
              style="--d:0.05s"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="featured-badge">Featured Project</span>
                  <h3 class="text-2xl md:text-3xl font-bold leading-snug">{featured.name}</h3>
                </div>
                {featured.link && (
                  <span class="inline-flex shrink-0 items-center justify-center w-10 h-10 rounded-full border border-[var(--border)] text-[var(--text-muted)] transition-all duration-300 group-hover:border-[var(--accent)] group-hover:text-[var(--accent)]">
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                    </svg>
                  </span>
                )}
              </div>
              <p class="mt-4 t-muted leading-relaxed max-w-3xl">{featured.description}</p>
              {featured.skills && featured.skills.length > 0 && (
                <div class="mt-6 flex flex-wrap gap-2">
                  {featured.skills.map((skill) => <span class="chip">{skill}</span>)}
                </div>
              )}
            </Tag>
          );
        })()}

        {/* Remaining projects grid */}
        {rest.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {rest.map((project, index) => {
              const Tag = project.link ? "a" : "div";
              const linkProps = project.link
                ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
                : {};
              return (
                <Tag
                  {...linkProps}
                  class={`card group relative flex flex-col p-7 reveal ${project.link ? "card-hover" : ""}`}
                  data-reveal={index % 2 === 0 ? "left" : "right"}
                  style={`--d:${(index + 1) * 0.06}s`}
                >
                  <div class="flex items-start justify-between gap-4">
                    <span class="serif text-2xl t-faint leading-none">
                      {String(index + 2).padStart(2, "0")}
                    </span>
                    {project.link && (
                      <span class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-[var(--border)] text-[var(--text-muted)] transition-all duration-300 group-hover:border-[var(--accent)] group-hover:text-[var(--accent)]">
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                        </svg>
                      </span>
                    )}
                  </div>
                  <h3 class="mt-4 text-xl font-semibold leading-snug">{project.name}</h3>
                  <p class="mt-3 t-muted leading-relaxed flex-1">{project.description}</p>
                  {project.skills && project.skills.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-2">
                      {project.skills.map((skill) => <span class="chip">{skill}</span>)}
                    </div>
                  )}
                </Tag>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )
}
