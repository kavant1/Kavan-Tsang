---
import { siteConfig } from "../config";
import { TubelightNavBar } from "./ui/tubelight-navbar";
---

<!-- PFD scroll-progress indicator (bottom-right) -->
<button id="scroll-progress" aria-label="Back to top">
  <svg viewBox="0 0 224 44" width="224" height="44" fill="none"
       stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <g id="mini-pfd">
        <path d="M2 22 H11" stroke-width="1.6"/>
        <path d="M9 18 L14 22 L9 26" stroke-width="1.6"/>
        <path d="M14 11 V33 H30 V11" stroke-width="1.6"/>
        <path d="M30 22 H48" stroke-width="1.6"/>
        <rect x="48" y="13" width="36" height="18" rx="2" stroke-width="1.6"/>
        <path d="M48 22 H84" stroke-width="0.9"/>
        <path d="M61 13 V6 M71 31 V38" stroke-width="1.2"/>
        <path d="M84 22 H102" stroke-width="1.6"/>
        <path d="M96 14 H102 M96 30 H102 M96 14 V30 M128 14 H134 M128 30 H134 M134 14 V30" stroke-width="1.2"/>
        <rect x="102" y="8" width="26" height="28" stroke-width="1.6"/>
        <path d="M115 8 V36" stroke-width="1.4"/>
        <path d="M107 17 H123 M107 27 H123" stroke-width="1.6"/>
        <path d="M128 22 H146" stroke-width="1.6"/>
        <path d="M146 13 L162 22 L146 31 Z" stroke-width="1.5"/>
        <path d="M162 13 L146 22 L162 31 Z" stroke-width="1.5"/>
        <path d="M154 13 V6 M149 6 H159" stroke-width="1.2"/>
        <path d="M162 22 H173" stroke-width="1.6"/>
        <rect x="173" y="2" width="18" height="40" rx="3" stroke-width="1.6"/>
        <path d="M173 13 H187 M178 22 H191 M173 31 H187" stroke-width="1.1"/>
        <path d="M191 9 H208 M206 5 L212 9 L206 13" stroke-width="1.5"/>
        <path d="M191 35 H208 M206 31 L212 35 L206 39" stroke-width="1.5"/>
      </g>
      <clipPath id="pfd-progress-clip">
        <rect id="pfd-clip-rect" x="-4" y="-4" width="0" height="52"/>
      </clipPath>
    </defs>
    <use href="#mini-pfd" opacity="0.15"/>
    <use href="#mini-pfd" clip-path="url(#pfd-progress-clip)"/>
  </svg>
</button>

<header id="site-header" class="site-header">
  <div class="shell nav-row">

    <!-- Brand -->
    <a href="/#top" class="brand" aria-label={siteConfig.name}>
      <span class="brand-mark">KT</span>
    </a>

    <!-- Tubelight nav (React island) -->
    <TubelightNavBar client:load />

    <!-- Theme toggle -->
    <div class="flex items-center gap-2.5">
      <button
        id="theme-toggle"
        class="icon-btn theme-toggle"
        aria-label="Toggle color theme"
        type="button"
      >
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // ── Scroll: header background + PFD progress + ocean depth ─────
  const header     = document.getElementById("site-header");
  const progressBtn = document.getElementById("scroll-progress");
  const pfdClipRect = document.getElementById("pfd-clip-rect") as SVGRectElement | null;
  const PFD_FULL_W  = 228;

  progressBtn?.addEventListener("click", () =>
    window.scrollTo({ top: 0, behavior: "smooth" })
  );

  const onScroll = () => {
    if (window.scrollY > 24) header?.classList.add("scrolled");
    else header?.classList.remove("scrolled");

    const total = document.documentElement.scrollHeight - window.innerHeight;
    const pct   = total > 0 ? window.scrollY / total : 0;

    document.documentElement.style.setProperty("--ocean-opacity", pct.toFixed(3));
    pfdClipRect?.setAttribute("width", String(pct * PFD_FULL_W));

    if (progressBtn) {
      if (window.scrollY > 200) progressBtn.classList.add("visible");
      else progressBtn.classList.remove("visible");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // ── Theme toggle ────────────────────────────────────────────────
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    // Freeze all transitions for one paint cycle so the swap is instant
    root.classList.add("theme-switching");
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) {}
    // Re-enable transitions on the next frame after the theme has been painted
    requestAnimationFrame(() => requestAnimationFrame(() =>
      root.classList.remove("theme-switching")
    ));
  });

  // ── Reveal on scroll ────────────────────────────────────────────
  const reveals = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
      }),
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
    );
    reveals.forEach(el => io.observe(el));
  } else {
    reveals.forEach(el => el.classList.add("is-visible"));
  }
</script>
